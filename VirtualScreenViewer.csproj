<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 11 SDK projection, for Windows Graphics Capture's borderless option; it still
         runs on Windows 10 2004 or later (the capture border is then simply left on). -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>VirtualScreenViewer</AssemblyName>
    <RootNamespace>VirtualScreenViewer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct3D 11, DXGI and Direct2D for drawing captured frames on the GPU. -->
    <PackageReference Include="Vortice.Direct2D1" Version="3.6.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>

</Project>
